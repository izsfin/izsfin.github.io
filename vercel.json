{
  "regions": ["fra1"],
  "rewrites": [
    { "source": "/api/check", "destination": "/api/check" },
    { "source": "/api/gen", "destination": "/api/gen" },
    { "source": "/api/promocodes", "destination": "/api/promocodes" },
    { "source": "/api/stats", "destination": "/api/stats" },
    { "source": "/api/logger", "destination": "/api/logger" },
    { "source": "/api/obfuscator", "destination": "/api/obfuscator" },
    { "source": "/api/docs/universal", "destination": "/api/docs/universal" },
    { "source": "/api/syntax", "destination": "/api/syntax" },
    { "source": "/api/hwid/auth/v1/start", "destination": "/api/hwid/auth/v1/start" },
    { "source": "/api/hwid/auth/v1/poll", "destination": "/api/hwid/auth/v1/poll" },
    { "source": "/api/hwid/auth/v1/bot-confirm", "destination": "/api/hwid/auth/v1/bot-confirm" },
    { "source": "/api/hwid/auth/v1/fca", "destination": "/api/hwid/auth/v1/fca" },
    { "source": "/api/tg/webhook", "destination": "/api/tg/webhook" },
    { "source": "/api/catalog/(.*)", "destination": "/api/catalog/$1" },
    { "source": "/(.*)", "destination": "/api/raw" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,OPTIONS,PATCH,DELETE,POST,PUT" },
        { "key": "Access-Control-Allow-Headers", "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version" }
      ]
    }
  ]
}